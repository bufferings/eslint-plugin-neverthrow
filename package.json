{
  "name": "@bufferings/eslint-plugin-neverthrow",
  "version": "0.2.12",
  "description": "",
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "husky",
    "clean": "rimraf dist",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "lint": "pnpm lint:ts && pnpm lint:eslint && pnpm lint:prettier",
    "lint:ts": "tsc --noEmit",
    "lint:eslint": "eslint",
    "lint:prettier": "prettier --check .",
    "fix": "pnpm fix:eslint && pnpm fix:prettier",
    "fix:eslint": "eslint --fix",
    "fix:prettier": "prettier --write .",
    "test": "vitest",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "peerDependencies": {
    "@typescript-eslint/parser": ">=8.48.0",
    "eslint": ">=9.0.0",
    "typescript": ">=5.6.0"
  },
  "dependencies": {
    "@typescript-eslint/utils": "8.48.0",
    "tsutils": "3.21.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.5.2",
    "@changesets/cli": "2.29.8",
    "@eslint/js": "9.39.1",
    "@types/eslint": "9.6.1",
    "@types/node": "20.19.25",
    "@typescript-eslint/parser": "8.48.0",
    "@typescript-eslint/rule-tester": "8.48.0",
    "eslint": "9.39.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-eslint-plugin": "6.3.2",
    "eslint-plugin-n": "17.23.1",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "husky": "9.1.7",
    "lint-staged": "15.2.10",
    "neverthrow": "8.2.0",
    "prettier": "3.7.2",
    "rimraf": "6.1.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vitest": "4.0.14"
  },
  "lint-staged": {
    "**/*": "pnpm fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bufferings/eslint-plugin-neverthrow.git"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "typescript"
  ],
  "author": "Mitz Shiiba",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bufferings/eslint-plugin-neverthrow/issues"
  },
  "homepage": "https://github.com/bufferings/eslint-plugin-neverthrow#readme"
}
